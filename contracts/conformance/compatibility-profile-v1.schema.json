{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-ash.github.io/agora-ai-sdlc/contracts/compatibility-profile-v1.schema.json",
  "title": "Agora AI-SDLC compatibility profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "canonical_model", "source", "stages", "capabilities", "neutrality"],
  "properties": {
    "schema": {"const": "agora-ai-sdlc/compatibility-profile/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "canonical_model": {"const": "agora-ai-sdlc/canonical-elements/v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "references", "affiliation", "runtime_dependency"],
      "properties": {
        "basis": {"const": "public"},
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://"}
        },
        "affiliation": {"const": false},
        "runtime_dependency": {"const": false}
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "maps_from"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "label": {"type": "string", "minLength": 1},
          "maps_from": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["readiness", "intent", "inception", "construction", "operations"]}
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional", "unsupported"],
      "properties": {
        "required": {"$ref": "#/$defs/capabilities"},
        "optional": {"$ref": "#/$defs/capabilities"},
        "unsupported": {"$ref": "#/$defs/capabilities"}
      }
    },
    "neutrality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "cloud", "scm", "agent-runtime"],
      "properties": {
        "provider": {"const": true},
        "model": {"const": true},
        "cloud": {"const": true},
        "scm": {"const": true},
        "agent-runtime": {"const": true}
      }
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    }
  }
}
