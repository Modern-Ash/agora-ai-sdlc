{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-ash.github.io/agora-ai-sdlc/contracts/domain-knowledge-source-v1.schema.json",
  "title": "Agora AI-SDLC domain knowledge source v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","id","kind","owner","classification","revision","scope","reference","description","metadata"],
  "properties": {
    "schema": {"const": "agora-ai-sdlc/domain-knowledge-source/v1"},
    "id": {"type":"string","pattern":"^[a-z][a-z0-9-]*$"},
    "kind": {"enum":["repository-docs","wiki","files","api","vector-store"]},
    "owner": {"type":"string","minLength":1},
    "classification": {"enum":["public","internal","confidential","restricted"]},
    "revision": {"type":"integer","minimum":1},
    "scope": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "reference": {"type":"string","minLength":1},
    "description": {"type":"string","minLength":1},
    "metadata": {"type":"object","additionalProperties":{"type":"string"}}
  }
}
