{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-ash.github.io/agora-ai-sdlc/contracts/conformance-facts-v1.schema.json",
  "title": "Agora AI-SDLC conformance facts v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "facts"],
  "properties": {
    "schema": {"const": "agora-ai-sdlc/conformance-facts/v1"},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "status", "reason"],
        "properties": {
          "capability": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "PARTIAL", "FAIL", "NOT_APPLICABLE"]},
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "reason": {"type": "string", "minLength": 1},
          "remediation": {"type": ["string", "null"], "minLength": 1}
        }
      }
    }
  }
}
